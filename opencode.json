{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": { "*": "allow", "*.env": "deny", "*.env.*": "deny" },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "npm test*": "allow",
      "npm run lint*": "allow",
      "npx vitest run*": "allow",
      "git push*": "deny",
      "rm *": "deny"
    }
  }
}
